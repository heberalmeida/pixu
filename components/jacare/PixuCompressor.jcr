import { pulse, derive } from '@jacare/core'
import { compress, downloadImageAs, createPreviewObjectURL } from '@pantanal/pixu'

export <contract>
  props: {
    options: { type: 'object', default: {} }
    samples: { type: 'any', default: [] }
    autoCompress: { type: 'boolean', default: true }
    instanceId: { type: 'string', default: 'default' }
  }
  emits: ['compress', 'error', 'progress', 'source']
</contract>

const instances = new Map()

function formatBytes(bytes) {
  if (!Number.isFinite(bytes) || bytes === 0) return '0 B'
  const sign = bytes < 0 ? '-' : ''
  const abs = Math.abs(bytes)
  const k = 1024
  const sizes = ['B', 'KB', 'MB', 'GB']
  const i = Math.min(sizes.length - 1, Math.floor(Math.log(abs) / Math.log(k)))
  return `${sign}${Math.round((abs / Math.pow(k, i)) * 100) / 100} ${sizes[i]}`
}

function getInstance(id) {
  const key = id || 'default'
  let inst = instances.get(key)
  if (inst) return inst

  const file = pulse(null)
  const loading = pulse(false)
  const progress = pulse(0)
  const error = pulse(null)
  const result = pulse(null)
  const originalUrl = pulse(null)
  const compressedUrl = pulse(null)
  const optionsProp = pulse({})
  const samplesProp = pulse([])
  const autoCompressProp = pulse(true)

  inst = {
    file,
    loading,
    progress,
    error,
    result,
    originalUrl,
    compressedUrl,
    optionsProp,
    samplesProp,
    autoCompressProp,
    optionsKey: '',
    emitHandler: null,
    inputId: `pixu-jacare-file-${key}`,
    progressPct: derive(() => `${Math.round(progress() * 100)}%`),
    progressLabel: derive(() => `Compressing... ${Math.round(progress() * 100)}%`),
    ratioLabel: derive(() => {
      const r = result()
      return r ? `${(r.compressionRatio * 100).toFixed(1)}%` : '—'
    }),
    savedLabel: derive(() => {
      const r = result()
      const f = file()
      if (!r || !f) return '—'
      return formatBytes(f.size - r.compressedSize)
    }),
    formatLabel: derive(() => {
      const r = result()
      return r ? r.format : '—'
    }),
    qualityLabel: derive(() => {
      const r = result()
      const q = r?.metadata?.quality
      return q != null ? `${Math.round(q * 100)}%` : '—'
    }),
    originalSizeLabel: derive(() => {
      const f = file()
      return f ? formatBytes(f.size) : '—'
    }),
    compressedSizeLabel: derive(() => {
      const r = result()
      return r ? formatBytes(r.compressedSize) : '—'
    }),
    compressedDims: derive(() => {
      const r = result()
      return r ? `${r.width}x${r.height}` : ''
    }),
    hasSamples: derive(() => {
      const list = samplesProp()
      return Array.isArray(list) && list.length > 0
    }),
  }

  instances.set(key, inst)
  return inst
}

function S(id) {
  return getInstance(id)
}

function emitOf(id, name, ...payload) {
  const handler = getInstance(id).emitHandler
  if (typeof handler === 'function') handler(name, ...payload)
}

function bindProps(id, nextSamples, nextOptions, nextAuto, mountEmit) {
  const s = getInstance(id)
  s.samplesProp.set(Array.isArray(nextSamples) ? nextSamples : [])
  s.optionsProp.set(nextOptions && typeof nextOptions === 'object' ? nextOptions : {})
  s.autoCompressProp.set(nextAuto !== false)
  s.emitHandler = typeof mountEmit === 'function' ? mountEmit : null
  const nextKey = JSON.stringify(s.optionsProp() || {})
  if (nextKey !== s.optionsKey) {
    const hadKey = s.optionsKey !== ''
    s.optionsKey = nextKey
    if (hadKey && s.file() && s.autoCompressProp() !== false && !s.loading()) {
      void recompress(id)
    }
  }
  return ''
}

function revokeUrls(id) {
  const s = getInstance(id)
  const prevOriginal = s.originalUrl()
  const prevCompressed = s.compressedUrl()
  if (prevOriginal) URL.revokeObjectURL(prevOriginal)
  if (prevCompressed) URL.revokeObjectURL(prevCompressed)
  s.originalUrl.set(null)
  s.compressedUrl.set(null)
}

function openFilePicker(id) {
  document.getElementById(getInstance(id).inputId)?.click()
}

function onUploadClick(e, id) {
  if (e.target.closest?.('.sample-gallery')) return
  openFilePicker(id)
}

async function onFileChange(e, id) {
  const selected = e.target.files?.[0]
  if (!selected) return
  await processFile(selected, id)
  e.target.value = ''
}

async function onDrop(e, id) {
  e.preventDefault()
  const dropped = e.dataTransfer?.files?.[0]
  if (dropped && dropped.type.startsWith('image/')) {
    await processFile(dropped, id)
  }
}

function onDragOver(e) {
  e.preventDefault()
}

async function loadSample(e, sample, id) {
  e.stopPropagation()
  const res = await fetch(sample.url)
  if (!res.ok) {
    const err = new Error(`Failed to load ${sample.label}`)
    getInstance(id).error.set(err.message)
    emitOf(id, 'error', err)
    return
  }
  const blob = await res.blob()
  const selected = new File([blob], sample.file, { type: blob.type || 'image/jpeg' })
  await processFile(selected, id)
}

async function runCompress(fileForCompress, id) {
  const s = getInstance(id)
  if (s.compressedUrl()) {
    URL.revokeObjectURL(s.compressedUrl())
    s.compressedUrl.set(null)
  }
  const compressionResult = await compress(fileForCompress, {
    ...(s.optionsProp() || {}),
    onProgress: (p) => {
      s.progress.set(p)
      emitOf(id, 'progress', p)
    },
  })
  s.result.set(compressionResult)
  s.compressedUrl.set(
    await createPreviewObjectURL(compressionResult.file, compressionResult.format)
  )
  emitOf(id, 'compress', compressionResult)
}

async function recompress(id) {
  const s = getInstance(id)
  const current = s.file()
  if (!current) return
  s.loading.set(true)
  s.error.set(null)
  s.progress.set(0)
  try {
    await runCompress(current, id)
  } catch (err) {
    const message = err instanceof Error ? err.message : 'Compression failed'
    s.error.set(message)
    emitOf(id, 'error', err instanceof Error ? err : new Error(message))
  } finally {
    s.loading.set(false)
  }
}

async function processFile(selected, id) {
  const s = getInstance(id)
  s.loading.set(true)
  s.error.set(null)
  s.progress.set(0)
  s.result.set(null)
  revokeUrls(id)

  try {
    const buffer = await selected.arrayBuffer()
    const type = selected.type || 'image/jpeg'
    const previewBlob = new Blob([buffer.slice(0)], { type })
    const appPreviewBlob = new Blob([buffer.slice(0)], { type })
    const fileForCompress = new File([buffer.slice(0)], selected.name, {
      type,
      lastModified: selected.lastModified,
    })

    s.file.set(fileForCompress)
    s.originalUrl.set(URL.createObjectURL(previewBlob))
    emitOf(id, 'source', {
      file: fileForCompress,
      url: URL.createObjectURL(appPreviewBlob),
    })

    if (s.autoCompressProp() === false) {
      s.loading.set(false)
      return
    }

    await runCompress(fileForCompress, id)
  } catch (err) {
    const message = err instanceof Error ? err.message : 'Compression failed'
    s.error.set(message)
    emitOf(id, 'error', err instanceof Error ? err : new Error(message))
  } finally {
    s.loading.set(false)
  }
}

async function downloadAs(id, format) {
  const s = getInstance(id)
  const r = s.result()
  const f = s.file()
  if (!r) return
  const base = (f?.name || 'image').replace(/\.[^.]+$/, '')
  try {
    await downloadImageAs(r.file, `compressed-${base}`, format)
  } catch (err) {
    const message = err instanceof Error ? err.message : 'Download failed'
    s.error.set(message)
    emitOf(id, 'error', err instanceof Error ? err : new Error(message))
  }
}

function reset(id) {
  const s = getInstance(id)
  s.file.set(null)
  s.result.set(null)
  s.error.set(null)
  s.progress.set(0)
  revokeUrls(id)
}

export <view>
  <div class="pixu-compressor" data-bind=${() => bindProps(instanceId, samples, options, autoCompress, emit)}>
    #if !S(instanceId).file()
      <div class="upload-area" on-click=${(e) => onUploadClick(e, instanceId)} on-dragover=${onDragOver} on-drop=${(e) => onDrop(e, instanceId)}>
        <input id=${() => S(instanceId).inputId} class="file-input" type="file" accept="image/*" on-change=${(e) => onFileChange(e, instanceId)} />
        <div class="upload-content">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <p class="upload-text">Click or drag image here to compress</p>
          <p class="upload-hint">Supports JPEG, PNG, WEBP, AVIF, PIXU</p>
        </div>
        #if S(instanceId).hasSamples()
          <div class="sample-gallery">
            <p class="sample-label">Or try a real sample</p>
            <div class="sample-grid">
            #for S(instanceId).samplesProp() as sample (sample.id)
              <button type="button" class="sample-card" on-click=${(e) => loadSample(e, sample, instanceId)}>
                <img src=${sample.url} alt=${sample.label} />
                <span>${sample.label}</span>
              </button>
            #end
            </div>
          </div>
        #end
      </div>
    #else
      <div class="compression-container">
        <div class="image-preview-section">
          <div class="image-preview">
            <h4>Original</h4>
            <img src=${() => S(instanceId).originalUrl()} alt="Original" />
            <div class="image-info">
              <span>${() => S(instanceId).originalSizeLabel()}</span>
            </div>
          </div>
          #if S(instanceId).result()
            <div class="image-preview">
              <h4>Compressed</h4>
              <img src=${() => S(instanceId).compressedUrl()} alt="Compressed" />
              <div class="image-info">
                <span>${() => S(instanceId).compressedSizeLabel()}</span>
                <span>${() => S(instanceId).compressedDims()}</span>
              </div>
            </div>
          #end
        </div>

        #if S(instanceId).loading()
          <div class="progress-section">
            <div class="progress-track">
              <div class="progress-bar" style---pct=${() => S(instanceId).progressPct()}></div>
            </div>
            <p class="progress-text">${() => S(instanceId).progressLabel()}</p>
          </div>
        #end

        #if S(instanceId).result()
          <div class="result-section">
            <div class="stats-grid">
              <div class="stat-item">
                <span class="stat-label">Compression Ratio</span>
                <span class="stat-value">${() => S(instanceId).ratioLabel()}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label">Size Reduction</span>
                <span class="stat-value">${() => S(instanceId).savedLabel()}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label">Format</span>
                <span class="stat-value">${() => S(instanceId).formatLabel()}</span>
              </div>
              <div class="stat-item">
                <span class="stat-label">Quality</span>
                <span class="stat-value">${() => S(instanceId).qualityLabel()}</span>
              </div>
            </div>
            <div class="actions">
              <button type="button" class="btn btn-primary" on-click=${() => downloadAs(instanceId, 'image/webp')}>Download (.webp)</button>
              <button type="button" class="btn btn-primary" on-click=${() => downloadAs(instanceId, 'image/jpeg')}>Download (.jpg)</button>
              <button type="button" class="btn btn-secondary" on-click=${() => reset(instanceId)}>Compress Another</button>
            </div>
          </div>
        #end

        #if S(instanceId).error()
          <div class="error-section">
            <p class="error-message">${() => S(instanceId).error()}</p>
            <button type="button" class="btn btn-secondary" on-click=${() => reset(instanceId)}>Try Again</button>
          </div>
        #end
      </div>
    #end
  </div>
</view>

export <style>
.pixu-compressor {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
}

.upload-area {
  border: 2px dashed var(--vp-c-divider, var(--pixu-border, #e2e2e3));
  border-radius: 8px;
  padding: 3rem;
  text-align: center;
  cursor: pointer;
  transition: border-color 0.2s, background 0.2s;
  background: var(--vp-c-bg-soft, var(--pixu-bg-soft, #f6f6f7));
}

.upload-area:hover {
  border-color: var(--vp-c-brand-1, var(--pixu-purple, #7b3fef));
  background: var(--vp-c-bg, var(--pixu-surface, #fff));
}

.file-input {
  display: none;
}

.upload-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}

.upload-content svg {
  color: var(--vp-c-text-2, var(--pixu-muted, #67676c));
}

.upload-text {
  font-size: 1.1rem;
  font-weight: 500;
  color: var(--vp-c-text-1, var(--pixu-text, #213547));
  margin: 0;
}

.upload-hint {
  font-size: 0.9rem;
  color: var(--vp-c-text-2, var(--pixu-muted, #67676c));
  margin: 0;
}

.sample-gallery {
  margin-top: 1.5rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--vp-c-divider, var(--pixu-border, #e2e2e3));
}

.sample-label {
  margin: 0 0 0.75rem;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--vp-c-text-2, var(--pixu-muted, #67676c));
}

.sample-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
  gap: 0.65rem;
}

.sample-card {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  padding: 0.35rem;
  border: 1px solid var(--vp-c-divider, var(--pixu-border, #e2e2e3));
  border-radius: 10px;
  background: var(--vp-c-bg, var(--pixu-surface, #fff));
  cursor: pointer;
  font: inherit;
  color: var(--vp-c-text-1, var(--pixu-text, #213547));
}

.sample-card:hover {
  border-color: var(--vp-c-brand-1, var(--pixu-purple, #7b3fef));
}

.sample-card img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: 6px;
}

.sample-card span {
  font-size: 0.72rem;
  font-weight: 600;
}

.compression-container {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.image-preview-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}

.image-preview {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.image-preview h4 {
  margin: 0;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--vp-c-text-1, var(--pixu-text, #213547));
}

.image-preview img {
  width: 100%;
  height: auto;
  border: 1px solid var(--vp-c-divider, var(--pixu-border, #e2e2e3));
  border-radius: 6px;
  max-height: 400px;
  object-fit: contain;
  background: var(--vp-c-bg-soft, var(--pixu-bg-soft, #f6f6f7));
}

.image-info {
  display: flex;
  justify-content: space-between;
  font-size: 0.85rem;
  color: var(--vp-c-text-2, var(--pixu-muted, #67676c));
}

.progress-section {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.progress-track {
  width: 100%;
  height: 8px;
  border-radius: 4px;
  background: var(--vp-c-bg-soft, var(--pixu-bg-soft, #f6f6f7));
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  width: var(--pct);
  background: var(--vp-c-brand-1, var(--pixu-purple, #7b3fef));
  border-radius: 4px;
  transition: width 0.15s ease;
}

.progress-text {
  text-align: center;
  font-size: 0.9rem;
  color: var(--vp-c-text-2, var(--pixu-muted, #67676c));
  margin: 0;
}

.result-section {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 1rem;
  padding: 1rem;
  background: var(--vp-c-bg-soft, var(--pixu-bg-soft, #f6f6f7));
  border-radius: 6px;
}

.stat-item {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.stat-label {
  font-size: 0.85rem;
  color: var(--vp-c-text-2, var(--pixu-muted, #67676c));
}

.stat-value {
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--vp-c-brand-1, var(--pixu-purple, #7b3fef));
}

.actions {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}

.btn {
  padding: 0.75rem 1.5rem;
  border: none;
  border-radius: 6px;
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
}

.btn-primary {
  background: var(--vp-c-brand-1, var(--pixu-purple, #7b3fef));
  color: #fff;
}

.btn-primary:hover {
  background: var(--vp-c-brand-2, #6a32d9);
  color: #fff;
}

.btn-secondary {
  background: var(--vp-c-bg-soft, var(--pixu-bg-soft, #f6f6f7));
  color: var(--vp-c-text-1, var(--pixu-text, #213547));
  border: 1px solid var(--vp-c-divider, var(--pixu-border, #e2e2e3));
}

.btn-secondary:hover {
  background: var(--vp-c-bg, #ffffff);
}

.error-section {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  align-items: center;
}

.error-message {
  margin: 0;
  color: #e24b4b;
  text-align: center;
}

@media (max-width: 640px) {
  .image-preview-section {
    grid-template-columns: 1fr;
  }
}
</style>
